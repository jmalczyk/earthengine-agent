# Google Cloud Project ID
GOOGLE_CLOUD_PROJECT="your-project-id"

# Google Cloud Region for model calls (e.g., us-central1)
GOOGLE_CLOUD_LOCATION="us-central1"

# Google Maps API Key (Requires Geocoding and Maps JavaScript API)
GOOGLE_MAPS_API_KEY="your-api-key"

# Use Vertex AI (TRUE/FALSE)
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# GeeViz MCP Server URL (Default for local: http://127.0.0.1:9001/mcp)
# For Cloud Shell Web Preview, use: https://9001-cs-[PROJECT_HASH].cloudshell.dev/mcp
GEEVIZ_MCP_URL="http://127.0.0.1:9001/mcp"
